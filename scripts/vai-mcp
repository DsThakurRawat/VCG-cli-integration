#!/usr/bin/env bash
# One entry point for every MCP agent (Claude Code, opencode, Codex, Cursor,
# Gemini CLI, ...): resolves this repo's binaries and per-tool config, then
# execs the requested stdio MCP server. Logs go to stderr only.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF_DIR="${VAI_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/virtuoso-ai}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/virtuoso-ai"
SAFE_CAPS="schematic,maestro,window,cell,simulation,transaction,library"
FULL_CAPS="$SAFE_CAPS,admin"
SAFE_DENY="evaluate,load_file"

usage() {
    cat >&2 <<USAGE
usage: vai-mcp <vcli|bridge|doctor>
  vcli     run vcli's MCP server (stdio)
  bridge   run virtuoso-bridge-lite's MCP server (stdio)
  doctor   check both sides and print the effective settings
settings (env, or in \$VAI_CONFIG_DIR/{vcli,bridge}.env; default dir $CONF_DIR):
  VAI_MODE=full|safe   full (default): raw SKILL allowed on both servers
                       safe: no raw SKILL, enforced even over inherited settings
                       (admin stripped from VCLI_CAPABILITY, $SAFE_DENY always denied)
  VAI_LOCK_FILE        cross-bridge lock (default /tmp/virtuoso-ai-bridge.lock)
  VAI_AUDIT_LOG        shared audit log (default $STATE_DIR/audit.jsonl; "off" disables)
  VCLI_BIN, VAI_PYTHON override binary / interpreter discovery
USAGE
}

log() { echo "[vai-mcp] $*" >&2; }

load_env() {
    local f="$CONF_DIR/$1.env"
    if [[ -f "$f" ]]; then
        set -a
        # shellcheck disable=SC1090
        . "$f"
        set +a
    fi
}

common() {
    export VAI_LOCK_FILE="${VAI_LOCK_FILE:-/tmp/virtuoso-ai-bridge.lock}"
    export VAI_AUDIT_LOG="${VAI_AUDIT_LOG:-$STATE_DIR/audit.jsonl}"
    VAI_MODE="${VAI_MODE:-full}"
    case "$VAI_MODE" in
        full | safe) ;;
        *) log "VAI_MODE must be full or safe (got '$VAI_MODE')"; exit 2 ;;
    esac
}

is_fork_vcli() {
    LC_ALL=C grep -qaF "VAI_LOCK_FILE" "$1" &&
        LC_ALL=C grep -qaF "VCIpcDataHandler" "$1" &&
        ! LC_ALL=C grep -qaF "RBIpcDataHandler" "$1"
}

find_vcli() {
    local c
    if [[ -n "${VCLI_BIN:-}" ]]; then
        if [[ -x "$VCLI_BIN" ]] && is_fork_vcli "$VCLI_BIN"; then
            echo "$VCLI_BIN"
            return 0
        fi
        log "VCLI_BIN=$VCLI_BIN is not this repo's namespaced vcli build (missing VC*/VAI_LOCK_FILE markers); refusing it"
        return 1
    fi
    for c in "$REPO/target/release/vcli" "$REPO/target/debug/vcli" "$(command -v vcli 2>/dev/null || true)"; do
        [[ -n "$c" && -x "$c" ]] || continue
        if is_fork_vcli "$c"; then
            echo "$c"
            return 0
        fi
        log "skipping $c: not this repo's namespaced vcli build (upstream vcli would collide with bridge-lite)"
    done
    return 1
}

strip_admin() {
    local p out=()
    IFS=, read -ra parts <<< "$1"
    for p in "${parts[@]}"; do
        p="${p//[[:space:]]/}"
        [[ -z "$p" || "${p,,}" == admin ]] && continue
        out+=("$p")
    done
    (IFS=,; echo "${out[*]}")
}

effective_caps() {
    local caps
    if [[ "$VAI_MODE" == full ]]; then
        echo "${VCLI_CAPABILITY:-$FULL_CAPS}"
        return
    fi
    caps="$(strip_admin "${VCLI_CAPABILITY:-$SAFE_CAPS}")"
    echo "${caps:-$SAFE_CAPS}"
}

effective_deny() {
    if [[ "$VAI_MODE" == safe ]]; then
        echo "$SAFE_DENY${VAI_DENY_TOOLS:+,$VAI_DENY_TOOLS}"
    else
        echo "${VAI_DENY_TOOLS:-}"
    fi
}

find_python() {
    local c
    for c in "${VAI_PYTHON:-}" "$REPO/python/.venv/bin/python" "$REPO/.venv/bin/python" "$(command -v python3 2>/dev/null || true)"; do
        [[ -n "$c" && -x "$c" ]] && "$c" -c 'import virtuoso_bridge' 2>/dev/null && { echo "$c"; return 0; }
    done
    return 1
}

run_vcli() {
    load_env vcli
    common
    local bin
    bin="$(find_vcli)" || { log "vcli not found: run ./install.sh --user or cargo build --release in $REPO"; exit 1; }
    VCLI_CAPABILITY="$(effective_caps)"
    export VCLI_CAPABILITY
    exec "$bin" mcp serve
}

run_bridge() {
    load_env bridge
    common
    export RB_REPLY_TAGS="${RB_REPLY_TAGS:-1}"
    VAI_DENY_TOOLS="$(effective_deny)"
    export VAI_DENY_TOOLS
    local py
    py="$(find_python)" || { log "virtuoso_bridge not importable: run 'uv venv python/.venv && uv pip install --python python/.venv/bin/python ./python' in $REPO"; exit 1; }
    exec "$py" "$REPO/python/mcp_server.py"
}

has() { if [[ -f "$1" ]]; then echo "present"; else echo "not set (optional)"; fi; }

writable() {
    if [[ -e "$1" ]]; then
        [[ -w "$1" ]] && echo "ok" || echo "NOT WRITABLE"
    else
        [[ -w "$(dirname "$1")" ]] && echo "ok, will be created on first use" || echo "NOT CREATABLE"
    fi
}

doctor() {
    common
    local bin py
    echo "repo          $REPO"
    echo "mode          $VAI_MODE"
    echo "config dir    $CONF_DIR (vcli.env: $(has "$CONF_DIR/vcli.env"), bridge.env: $(has "$CONF_DIR/bridge.env"))"
    if bin="$(find_vcli 2>/dev/null)"; then
        echo "vcli          ok   $bin ($("$bin" --version 2>/dev/null | head -1), verified fork build)"
    else
        echo "vcli          NOT READY  no verified fork build found (./install.sh --user, or cargo build --release; upstream vcli is rejected)"
    fi
    echo "vcli caps     $(load_env vcli; common; echo "$(effective_caps)  (mode $VAI_MODE)")"
    echo "bridge deny   $(load_env bridge; common; echo "$(effective_deny)  (mode $VAI_MODE)")"
    if py="$(find_python)"; then
        echo "bridge-lite   ok   $py"
    else
        echo "bridge-lite   MISSING  (uv venv python/.venv && uv pip install --python python/.venv/bin/python ./python)"
    fi
    echo "lock file     $VAI_LOCK_FILE ($(writable "$VAI_LOCK_FILE"))"
    echo "audit log     $VAI_AUDIT_LOG"
    if [[ -e "$VAI_LOCK_FILE.quarantine" || -L "$VAI_LOCK_FILE.quarantine" ]]; then
        echo "quarantine    ACTIVE  $VAI_LOCK_FILE.quarantine: $(head -c 300 "$VAI_LOCK_FILE.quarantine" 2>/dev/null)"
        echo "              both bridges refuse work; remove it only after confirming the CIW is idle"
    else
        echo "quarantine    none"
    fi
    echo "live checks   virtuoso-bridge eval '1+2'   |   VCLI_CAPABILITY=admin vcli skill exec 'getCurrentTime()'"
}

case "${1:-}" in
    vcli) run_vcli ;;
    bridge) run_bridge ;;
    doctor) doctor ;;
    -h | --help | help) usage ;;
    *) usage; exit 2 ;;
esac
