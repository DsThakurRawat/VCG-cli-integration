+fn join_xdotool_commands(display_prefix: &str, cmds: Vec<(String, Vec<String>)>) -> String {
+    cmds.into_iter()
+        .map(|(_sub, argv)| {
+            format!(
+                "{}xdotool {}",
+                display_prefix,
+                argv.iter()
+                    .map(|a| shell_escape(a))
+                    .collect::<Vec<_>>()
+                    .join(" ")
+            )
+        })
+        .collect::<Vec<_>>()
+        .join(" && ")
